SECRET_KEY=change-this-to-a-long-random-secret-string
# Supabase POOLER string (Project Settings > Database > Connection string > Pooler)
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
ENABLE_SCHEDULER=true

# Video calls work with no keys. Optional TURN relay for restrictive mobile networks:
# TURN_URLS=turn:your-relay-host:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
